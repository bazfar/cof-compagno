        <mxCell id="legende2" parent="1" style="text;html=1;align=left;fontSize=11;fontStyle=2;" value="Plein = en place (L0, L5.3)  |  Pointillé = prévu par le cadrage, refusé par les règles tant que son lot ne l'ouvre pas  |  Gris = v1        (losange = contient)" vertex="1">
          <mxGeometry height="20" width="1400" x="40" y="42" as="geometry" />
        </mxCell>
        <mxCell id="v1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;v1 : projet lejdr-b38ef, à part&lt;/b&gt;&lt;hr&gt;sessions/table-arbre-monde/** :&lt;br&gt;cof_persos, cof_joueurs, cof_livres…&lt;br&gt;ses propres règles (racine du dépôt)&lt;br&gt;fiches reprises par export JSON (L7)" vertex="1">
