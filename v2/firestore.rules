rules_version = '2';

// ============================================================
// Règles Firestore — cof-compagno 2.0 (projet Firebase lejdr-v2)
//
// La 2.0 a son propre projet Firebase depuis le 16/10/2026 : la v1 garde
// le sien (lejdr-b38ef) et ses règles, déployées depuis la racine du
// dépôt. Ce fichier ne couvre donc que la 2.0 ; tout ce qui n'est pas
// ouvert ici est refusé (test « tout le reste est refusé »).
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() {
      return request.auth != null;
    }
    function estMj(table) {
      return connecte()
        && exists(/databases/$(database)/documents/tables/$(table)/mjs/$(request.auth.uid));
    }
    function estJoueur(table) {
      return connecte()
        && exists(/databases/$(database)/documents/tables/$(table)/joueurs/$(request.auth.uid));
    }
    function estMembre(table) {
      return estMj(table) || estJoueur(table);
    }
    function nomValide(nom) {
      return nom is string && nom.size() >= 1 && nom.size() <= 40;
    }
    function coordValide(c) {
      return c is int && c >= 0 && c <= 499;
    }
    // Aligné sur schemaJeton (src/lib/schemas/carte.ts).
    function jetonValide(d) {
      return d.keys().hasAll(['genre', 'nom', 'couleur', 'cx', 'cy', 'proprietaire', 'creeLe'])
        && d.keys().hasOnly(['genre', 'nom', 'couleur', 'cx', 'cy', 'mort', 'proprietaire', 'creeLe'])
        && d.genre in ['pj', 'monstre', 'invocation', 'libre']
        && nomValide(d.nom)
        && d.couleur is string && d.couleur.matches('^#[0-9a-fA-F]{6}$')
        && coordValide(d.cx) && coordValide(d.cy)
        && (!('mort' in d) || d.mort is bool)
        && (d.proprietaire == null || d.proprietaire is string)
        && d.creeLe is int;
    }
    function pointValide(c) {
      return c is number && c >= 0 && c <= 500;
    }
    // Aligné sur schemaDessin (src/lib/schemas/carte.ts).
    function dessinValide(d) {
      return d.keys().hasAll(['type', 'ax', 'ay', 'bx', 'by', 'creeLe'])
        && d.keys().hasOnly(['type', 'ax', 'ay', 'bx', 'by', 'ouverte', 'tours', 'lanceur', 'creeLe'])
        && d.type in ['mur', 'obstacle', 'porte']
        && pointValide(d.ax) && pointValide(d.ay) && pointValide(d.bx) && pointValide(d.by)
        && (!('ouverte' in d) || d.ouverte is bool)
        && (!('tours' in d) || (d.tours is int && d.tours >= 1 && d.tours <= 100))
        && (!('lanceur' in d) || d.lanceur == null || d.lanceur is string)
        && d.creeLe is int;
    }
    // Fiche de personnage (lot L2.1). Aligné sur schemaFiche
    // (src/lib/schemas/fiche.ts) ; la forme détaillée est vérifiée par Zod
    // dans l'app, les règles bornent les champs et l'essentiel.
    function ficheValide(d) {
      return d.keys().hasOnly([
          'schemaVersion', 'proprietaireUid', 'creeLe', 'nom', 'genre', 'niveau',
          'classe', 'race', 'raceVariante', 'caracs', 'capacites', 'capacitesRace',
          'capacitesRaceChoix', 'voiesHorsProfil', 'dons', 'donsChoix', 'bonusCompetences', 'pvMax',
          'pvActuel', 'pvHistorique', 'ppActuel', 'pointsCercle', 'equipement', 'inventaire',
          'piecesOr', 'piecesArgent', 'piecesBronze', 'etatsActifs', 'mutations', 'corruptionCombat',
          'corruptionMajeure', 'contratDemoniaquePenalite', 'amesStockees', 'grimoireSortsConnus', 'grimoireSortsPrepares', 'cercleSpecialisation',
          'progression', 'vecu', 'usages', 'notes', 'modules'])
        && d.keys().hasAll(['schemaVersion', 'proprietaireUid', 'creeLe', 'nom', 'niveau', 'pvMax', 'inventaire', 'equipement',
          'progression', 'vecu', 'usages'])
        && d.schemaVersion == 1
        && d.proprietaireUid is string
        && nomValide(d.nom)
        && d.niveau is int && d.niveau >= 1 && d.niveau <= 20
        && d.pvMax is int && d.pvMax >= 0
        && d.inventaire is map && d.equipement is map
        && d.progression is map && d.progression.crans is int
        && d.vecu is map && d.vecu.crans is int && d.vecu.paliers is int && d.vecu.points is int
        && d.usages is map
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 10000))
        && d.creeLe is int;
    }
    // Aligné sur schemaImportV1 (src/lib/schemas/import-v1.ts).
    function importValide(d) {
      return d.keys().hasOnly(['proprietaireUid', 'nom', 'importeLe', 'v1Json', 'reprisPar'])
        && d.keys().hasAll(['proprietaireUid', 'nom', 'importeLe', 'v1Json'])
        && d.proprietaireUid is string
        && nomValide(d.nom)
        && d.importeLe is int
        && d.v1Json is string && d.v1Json.size() <= 900000
        && (!('reprisPar' in d) || d.reprisPar is string);
    }
    // Aligné sur schemaJalon (src/lib/schemas/jalon.ts).
    function jalonValide(d) {
      return d.keys().hasOnly(['barre', 'delta', 'libelle', 'parUid', 'creeLe'])
        && d.keys().hasAll(['barre', 'delta', 'libelle', 'parUid', 'creeLe'])
        && d.barre == 'niveau'
        && (d.delta == 1 || d.delta == -1)
        && d.libelle is string && d.libelle.size() <= 80
        && d.parUid == request.auth.uid
        && d.creeLe is int;
    }
    // Aligné sur schemaJetJournal (src/lib/schemas/journal.ts).
    function jetValide(d) {
      return d.keys().hasOnly(['auteurUid', 'auteurNom', 'perso', 'libelle', 'formule', 'des', 'bonus', 'total', 'creeLe'])
        && d.keys().hasAll(['auteurUid', 'auteurNom', 'libelle', 'formule', 'des', 'bonus', 'total', 'creeLe'])
        && d.auteurUid == request.auth.uid
        && nomValide(d.auteurNom)
        && (!('perso' in d) || nomValide(d.perso))
        && d.libelle is string && d.libelle.size() >= 1 && d.libelle.size() <= 80
        && d.formule is string && d.formule.size() >= 1 && d.formule.size() <= 40
        && d.des is list && d.des.size() >= 1 && d.des.size() <= 100
        && d.bonus is int && d.total is int && d.creeLe is int;
    }
    // Personnage joué d'un joueur (joueurs/{uid}.persoActif), '' s'il n'en a pas.
    function persoJoueDe(table, uid) {
      return get(/databases/$(database)/documents/tables/$(table)/joueurs/$(uid)).data.get('persoActif', '');
    }
    function proprietaireDuPerso(table, perso) {
      return estJoueur(table)
        && get(/databases/$(database)/documents/tables/$(table)/persos/$(perso)).data.proprietaireUid == request.auth.uid;
    }
    // Aligné sur schemaPortrait (src/lib/schemas/portrait.ts).
    function portraitValide(d) {
      return d.keys().hasOnly(['image', 'majLe'])
        && d.keys().hasAll(['image', 'majLe'])
        && d.image is string && d.image.size() <= 150000
        && d.image.matches('^data:image/(jpeg|webp|png);base64,.*')
        && d.majLe is int;
    }
    // Un joueur crée son personnage sans crans ni Vécu (seul le MJ en donne).
    function progressionVierge(d) {
      return d.progression.crans == 0 && d.vecu.crans == 0 && d.vecu.paliers == 0 && d.vecu.points == 0;
    }
    // Vécu modifié par son joueur : il choisit ses nœuds et dépense ses
    // points, sans toucher aux crans ni aux paliers, que donne le MJ.
    function vecuChoisiParJoueur(apres, avant) {
      return apres.crans == avant.crans && apres.paliers == avant.paliers && apres.points <= avant.points;
    }
    // Aligné sur schemaEtatScene (src/lib/schemas/carte.ts).
    function etatSceneValide(d) {
      return d.keys().hasOnly(['portesOuvertes', 'exploration', 'explorationRaz'])
        && (!('portesOuvertes' in d) || d.portesOuvertes is map)
        && (!('exploration' in d) || (d.exploration is string && d.exploration.size() <= 20000))
        && (!('explorationRaz' in d) || d.explorationRaz is int);
    }

    match /tables/{table} {
      allow read: if estMembre(table);
      allow write: if estMj(table);

      // Code MJ : posé à la main dans la console Firebase, jamais lisible
      // ni modifiable par un client. Seules les règles le consultent.
      match /secret/{document} {
        allow read, write: if false;
      }

      // Devenir MJ : uniquement pour soi, avec le bon code.
      match /mjs/{uid} {
        allow read: if connecte() && (request.auth.uid == uid || estMj(table));
        allow create: if connecte()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['nom', 'code', 'rejointLe'])
          && nomValide(request.resource.data.nom)
          && request.resource.data.rejointLe is int
          && request.resource.data.code
             == get(/databases/$(database)/documents/tables/$(table)/secret/codeMj).data.code;
        allow update, delete: if false;
      }

      // Devenir joueur : uniquement pour soi. Le MJ peut retirer un joueur.
      match /joueurs/{uid} {
        allow read: if connecte() && (request.auth.uid == uid || estMembre(table));
        allow create, update: if connecte()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['nom', 'couleur', 'persoActif', 'rejointLe'])
          && nomValide(request.resource.data.nom)
          && request.resource.data.rejointLe is int;
        allow delete: if estMj(table);
      }

      // ---- Battlemap (lot L5.3) ----
      // Les règles vérifient les DROITS ; les règles de jeu (murs, portes
      // fermées, case occupée) sont appliquées par l'app avant d'écrire,
      // comme en v1 : Firestore ne connaît pas la géométrie des scènes.
      // `sceneActive` (scène montrée) est un champ du document de table,
      // écrit par le MJ (règle de /tables/{table} ci-dessus).
      match /scenes/{scene} {
        allow read: if estMembre(table);
        // MJ : portes, exploration et sa remise à zéro.
        allow create, update: if estMj(table) && etatSceneValide(request.resource.data);
        // Joueur : seulement les portes (n'importe laquelle, décision 3b).
        allow create: if estJoueur(table)
          && request.resource.data.keys().hasOnly(['portesOuvertes'])
          && request.resource.data.portesOuvertes is map;
        allow update: if estJoueur(table)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['portesOuvertes'])
          && request.resource.data.portesOuvertes is map;
        allow delete: if estMj(table);

        // Dessins du MJ (lot L5.4) : murs, obstacles, portes, mur de force.
        // Le MJ seul les trace et les efface ; une porte dessinée s'ouvre
        // comme les autres, par portesOuvertes (ci-dessus).
        match /dessins/{dessin} {
          allow read: if estMembre(table);
          allow create, update: if estMj(table) && dessinValide(request.resource.data);
          allow delete: if estMj(table);
        }

        // Un document par jeton. Le MJ pose, bouge, tue et retire tout. Un
        // joueur pose le jeton de son personnage JOUÉ (identifiant
        // pj-<id du personnage>, L2.3 ; L5.3 : pj-<uid>), ne bouge que ses
        // jetons (cx et cy seulement) et peut les retirer.
        match /jetons/{jeton} {
          allow read: if estMembre(table);
          allow create: if jetonValide(request.resource.data)
            && (estMj(table)
              || (estJoueur(table)
                && persoJoueDe(table, request.auth.uid) != ''
                && jeton == 'pj-' + persoJoueDe(table, request.auth.uid)
                && get(/databases/$(database)/documents/tables/$(table)/persos/$(persoJoueDe(table, request.auth.uid))).data.proprietaireUid == request.auth.uid
                && request.resource.data.genre == 'pj'
                && request.resource.data.proprietaire == request.auth.uid
                && !('mort' in request.resource.data)));
          allow update: if jetonValide(request.resource.data)
            && (estMj(table)
              || (estJoueur(table)
                && resource.data.proprietaire == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cx', 'cy'])));
          allow delete: if estMj(table)
            || (estJoueur(table) && resource.data.proprietaire == request.auth.uid);
        }
      }

      // Scènes importées par le MJ depuis une image (lot L5.5) : la
      // description d'un côté (légère, listée par tous), l'image de l'autre
      // (téléchargée seulement à l'ouverture de la scène).
      match /scenesImportees/{scene} {
        allow read: if estMembre(table);
        allow create, update: if estMj(table)
          && request.resource.data.keys().hasOnly(['nom', 'colonnes', 'lignes', 'pxParCase', 'creeLe'])
          && request.resource.data.keys().hasAll(['nom', 'colonnes', 'lignes', 'pxParCase', 'creeLe'])
          && nomValide(request.resource.data.nom)
          && request.resource.data.colonnes is int && request.resource.data.colonnes >= 1 && request.resource.data.colonnes <= 150
          && request.resource.data.lignes is int && request.resource.data.lignes >= 1 && request.resource.data.lignes <= 150
          && request.resource.data.pxParCase is int && request.resource.data.pxParCase >= 1 && request.resource.data.pxParCase <= 512
          && request.resource.data.creeLe is int;
        allow delete: if estMj(table);

        match /image/{document} {
          allow read: if estMembre(table);
          allow create, update: if estMj(table)
            && request.resource.data.keys().hasOnly(['image'])
            && request.resource.data.image is string
            && request.resource.data.image.matches('^data:image/.*')
            && request.resource.data.image.size() <= 750000;
          allow delete: if estMj(table);
        }
      }

      // Fiches de personnage (lot L2.1). Toute la table les lit (la fiche
      // vivante du MJ, les cartes compactes du groupe). Un joueur crée et
      // modifie SES personnages (il peut en avoir plusieurs, décision 2a),
      // sans pouvoir les donner à un autre ni se donner des crans de
      // progression ou de Vécu (le MJ les donne ; le joueur choisit ses
      // nœuds). Le MJ fait tout ; lui seul supprime. Les documents de crans
      // (persos/{id}/jalons, L2.5) : le MJ seul les crée, personne ne les
      // modifie ni ne les supprime.
      // Fiches v1 déposées par le MJ pour un joueur (lot L2.2c, décision 6a).
      // Le joueur ne lit que les siennes et ne fait qu'une chose : noter,
      // une seule fois, le personnage qui en est né (reprisPar).
      match /importsV1/{imp} {
        allow read: if estMj(table)
          || (estJoueur(table) && resource.data.proprietaireUid == request.auth.uid);
        allow create: if estMj(table) && importValide(request.resource.data);
        allow delete: if estMj(table);
        allow update: if importValide(request.resource.data)
          && (estMj(table)
            || (estJoueur(table)
              && resource.data.proprietaireUid == request.auth.uid
              && !('reprisPar' in resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reprisPar'])));
      }

      match /persos/{perso} {
        allow read: if estMembre(table);
        allow create: if ficheValide(request.resource.data)
          && (estMj(table)
            || (estJoueur(table)
              && request.resource.data.proprietaireUid == request.auth.uid
              && progressionVierge(request.resource.data)));
        allow update: if ficheValide(request.resource.data)
          && (estMj(table)
            || (estJoueur(table)
              && resource.data.proprietaireUid == request.auth.uid
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['proprietaireUid', 'schemaVersion', 'creeLe', 'progression'])
              && vecuChoisiParJoueur(request.resource.data.vecu, resource.data.vecu)));
        allow delete: if estMj(table);

        // Portrait (L2.3, décision 6a) : un document à part, lu par toute la
        // table (avatar, jeton) ; le propriétaire du personnage et le MJ le
        // changent ou le retirent.
        match /images/{image} {
          allow read: if estMembre(table);
          allow create, update: if image == 'portrait'
            && portraitValide(request.resource.data)
            && (estMj(table) || proprietaireDuPerso(table, perso));
          allow delete: if estMj(table) || proprietaireDuPerso(table, perso);
        }

        // Crans de progression (L2.5) : un document par cran, en ajout seul,
        // écrit par le MJ dans la même transaction que progression.crans.
        match /jalons/{jalon} {
          allow read: if estMembre(table);
          allow create: if estMj(table) && jalonValide(request.resource.data);
          allow update, delete: if false;
        }
      }

      // Journal de dés commun (L2.5, décision 4a) : toute la table lit tous
      // les jets ; chacun n'ajoute que les siens ; personne ne modifie ni ne
      // supprime un jet.
      match /journal/{jet} {
        allow read: if estMembre(table);
        allow create: if estMembre(table) && jetValide(request.resource.data);
        allow update, delete: if false;
      }

      // Toute autre collection (combat…) est refusée par défaut :
      // chaque lot ouvre la sienne avec ses propres tests.
    }
  }
}
