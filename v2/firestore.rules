rules_version = '2';

// ============================================================
// Règles Firestore — cof-compagno 2.0 (projet Firebase lejdr-v2)
//
// La 2.0 a son propre projet Firebase depuis le 16/10/2026 : la v1 garde
// le sien (lejdr-b38ef) et ses règles, déployées depuis la racine du
// dépôt. Ce fichier ne couvre donc que la 2.0 ; tout ce qui n'est pas
// ouvert ici est refusé (test « tout le reste est refusé »).
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() {
      return request.auth != null;
    }
    function estMj(table) {
      return connecte()
        && exists(/databases/$(database)/documents/tables/$(table)/mjs/$(request.auth.uid));
    }
    function estJoueur(table) {
      return connecte()
        && exists(/databases/$(database)/documents/tables/$(table)/joueurs/$(request.auth.uid));
    }
    function estMembre(table) {
      return estMj(table) || estJoueur(table);
    }
    function nomValide(nom) {
      return nom is string && nom.size() >= 1 && nom.size() <= 40;
    }
    function coordValide(c) {
      return c is int && c >= 0 && c <= 499;
    }
    // Aligné sur schemaJeton (src/lib/schemas/carte.ts).
    function jetonValide(d) {
      return d.keys().hasAll(['genre', 'nom', 'couleur', 'cx', 'cy', 'proprietaire', 'creeLe'])
        && d.keys().hasOnly(['genre', 'nom', 'couleur', 'cx', 'cy', 'mort', 'proprietaire', 'creeLe'])
        && d.genre in ['pj', 'monstre', 'invocation', 'libre']
        && nomValide(d.nom)
        && d.couleur is string && d.couleur.matches('^#[0-9a-fA-F]{6}$')
        && coordValide(d.cx) && coordValide(d.cy)
        && (!('mort' in d) || d.mort is bool)
        && (d.proprietaire == null || d.proprietaire is string)
        && d.creeLe is int;
    }
    function pointValide(c) {
      return c is number && c >= 0 && c <= 500;
    }
    // Aligné sur schemaDessin (src/lib/schemas/carte.ts).
    function dessinValide(d) {
      return d.keys().hasAll(['type', 'ax', 'ay', 'bx', 'by', 'creeLe'])
        && d.keys().hasOnly(['type', 'ax', 'ay', 'bx', 'by', 'ouverte', 'tours', 'lanceur', 'creeLe'])
        && d.type in ['mur', 'obstacle', 'porte']
        && pointValide(d.ax) && pointValide(d.ay) && pointValide(d.bx) && pointValide(d.by)
        && (!('ouverte' in d) || d.ouverte is bool)
        && (!('tours' in d) || (d.tours is int && d.tours >= 1 && d.tours <= 100))
        && (!('lanceur' in d) || d.lanceur == null || d.lanceur is string)
        && d.creeLe is int;
    }
    // Fiche de personnage (lot L2.1). Aligné sur schemaFiche
    // (src/lib/schemas/fiche.ts) ; la forme détaillée est vérifiée par Zod
    // dans l'app, les règles bornent les champs et l'essentiel.
    // Deux versions (lot L4.11a) : la v1, et la fiche convertie à la refonte
    // (schemaFicheV1, schemaFicheV2). Chacune a sa liste de champs.
    function ficheValide(d) {
      return (d.schemaVersion == 1 && ficheV1Valide(d)) || (d.schemaVersion == 2 && ficheV2Valide(d));
    }
    function ficheV1Valide(d) {
      return d.keys().hasOnly([
          'schemaVersion', 'proprietaireUid', 'creeLe', 'nom', 'genre', 'niveau',
          'classe', 'race', 'raceVariante', 'caracs', 'capacites', 'capacitesRace',
          'capacitesRaceChoix', 'voiesHorsProfil', 'dons', 'donsChoix', 'bonusCompetences', 'pvMax',
          'pvActuel', 'pvHistorique', 'ppActuel', 'pointsCercle', 'equipement', 'inventaire',
          'piecesOr', 'piecesArgent', 'piecesBronze', 'etatsActifs', 'mutations', 'corruptionCombat',
          'corruptionMajeure', 'contratDemoniaquePenalite', 'amesStockees', 'grimoireSortsConnus', 'grimoireSortsPrepares', 'cercleSpecialisation',
          'progression', 'vecu', 'usages', 'notes', 'modules'])
        && ficheCommuneValide(d);
    }
    function ficheV2Valide(d) {
      return d.keys().hasOnly([
          'schemaVersion', 'proprietaireUid', 'creeLe', 'nom', 'genre', 'niveau',
          'classe', 'race', 'raceVariante', 'caracs', 'capacitesRace',
          'capacitesRaceChoix', 'dons', 'donsChoix', 'bonusCompetences', 'pvMax',
          'pvActuel', 'pvHistorique', 'ppActuel', 'equipement', 'inventaire',
          'piecesOr', 'piecesArgent', 'piecesBronze', 'etatsActifs', 'mutations',
          'contratDemoniaquePenalite', 'amesStockees',
          'progression', 'vecu', 'usages', 'notes', 'modules', 'refonte', 'octrois'])
        && d.keys().hasAll(['refonte', 'octrois'])
        && d.refonte is map && d.refonte.rangs is map && d.refonte.jauges is map
        && d.refonte.jauges.plongee is int && d.refonte.jauges.corruptionAme is int
        && octroisValides(d.octrois)
        && ficheCommuneValide(d);
    }
    // Ce que le MJ accorde (schemaOctrois) : le joueur ne l'écrit pas, sauf à
    // sa conversion et pour refermer une reconversion (refonteParJoueur).
    function octroisValides(o) {
      return o is map && o.keys().hasOnly(['chaos', 'elements', 'verbes', 'reconversion', 'vecuV1'])
        && o.chaos is bool && o.elements is map && o.verbes is list && o.verbes.size() <= 30 && o.reconversion is bool
        && (!('vecuV1' in o) || (o.vecuV1 is list && o.vecuV1.size() <= 20));
    }
    function octroisVierges(o) {
      return o.chaos == false && o.elements.size() == 0 && o.verbes.size() == 0 && o.reconversion == false;
    }
    // Ce que le joueur change seul à la refonte de son personnage :
    //   - la conversion (v1 → v2), une fois : rien d'accordé, sauf la Voie du
    //     chaos qu'il avait en v1 (décision 12a ; vérifiée par l'app) ;
    //   - une reconversion rouverte par le MJ, qu'il referme en la faisant ;
    //   - à la montée de niveau, ses nouveaux rangs ;
    //   - à tout moment, ses jauges (Endurance, Inspiration…).
    function refonteParJoueur(apres, avant) {
      return (avant.schemaVersion == 1 && apres.schemaVersion == 2
          && apres.octrois.elements.size() == 0 && apres.octrois.verbes.size() == 0 && apres.octrois.reconversion == false)
        || (avant.schemaVersion == 2 && apres.schemaVersion == 2
          && (!apres.diff(avant).affectedKeys().hasAny(['octrois'])
            || (avant.octrois.reconversion == true && apres.octrois.reconversion == false
              && apres.octrois.diff(avant.octrois).affectedKeys().hasOnly(['reconversion'])))
          && (!apres.diff(avant).affectedKeys().hasAny(['refonte'])
            || apres.refonte.diff(avant.refonte).affectedKeys().hasOnly(['jauges'])
            || avant.octrois.reconversion == true
            || apres.niveau == avant.niveau + 1));
    }
    function ficheCommuneValide(d) {
      return d.keys().hasAll(['schemaVersion', 'proprietaireUid', 'creeLe', 'nom', 'niveau', 'pvMax', 'inventaire', 'equipement',
          'progression', 'vecu', 'usages'])
        && d.proprietaireUid is string
        && nomValide(d.nom)
        && d.niveau is int && d.niveau >= 1 && d.niveau <= 20
        && d.pvMax is int && d.pvMax >= 0
        && d.inventaire is map && d.equipement is map
        && d.progression is map && d.progression.crans is int
        && d.vecu is map && d.vecu.crans is int && d.vecu.paliers is int && d.vecu.points is int
        && d.usages is map
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 10000))
        && d.creeLe is int;
    }
    // Aligné sur schemaImportV1 (src/lib/schemas/import-v1.ts).
    function importValide(d) {
      return d.keys().hasOnly(['proprietaireUid', 'nom', 'importeLe', 'v1Json', 'reprisPar'])
        && d.keys().hasAll(['proprietaireUid', 'nom', 'importeLe', 'v1Json'])
        && d.proprietaireUid is string
        && nomValide(d.nom)
        && d.importeLe is int
        && d.v1Json is string && d.v1Json.size() <= 900000
        && (!('reprisPar' in d) || d.reprisPar is string);
    }
    // Aligné sur schemaJalon (src/lib/schemas/jalon.ts).
    function jalonValide(d) {
      return d.keys().hasOnly(['barre', 'delta', 'libelle', 'parUid', 'seance', 'creeLe'])
        && d.keys().hasAll(['barre', 'delta', 'libelle', 'parUid', 'creeLe'])
        && (d.barre == 'niveau' || d.barre == 'vecu')
        && (d.delta == 1 || d.delta == -1)
        && d.libelle is string && d.libelle.size() <= 80
        && d.parUid == request.auth.uid
        && (!('seance' in d) || (d.seance is string && d.seance.size() >= 1 && d.seance.size() <= 100))
        && d.creeLe is int;
    }
    // Aligné sur schemaDon (src/lib/schemas/don.ts), lot L3.3.
    function donValide(d) {
      return d.keys().hasOnly(['deUid', 'dePerso', 'deNom', 'aUid', 'aPerso', 'aNom', 'objet', 'statut', 'creeLe', 'resoluLe'])
        && d.keys().hasAll(['deUid', 'dePerso', 'deNom', 'aUid', 'aPerso', 'aNom', 'objet', 'statut', 'creeLe', 'resoluLe'])
        && d.deUid is string && d.deUid.size() >= 1
        && d.dePerso is string && d.dePerso.size() >= 1
        && d.deNom is string && d.deNom.size() >= 1 && d.deNom.size() <= 80
        && d.aUid is string && d.aUid.size() >= 1
        && d.aPerso is string && d.aPerso.size() >= 1
        && d.aNom is string && d.aNom.size() >= 1 && d.aNom.size() <= 80
        && d.objet is map
        && d.statut in ['propose', 'accepte', 'refuse', 'repris', 'annule']
        && d.creeLe is int
        && (d.resoluLe == null || d.resoluLe is int);
    }
    // Un don ne change que de statut (et de date de règlement), selon qui agit :
    // le receveur accepte ou refuse une proposition ; le donneur l'annule, ou
    // reprend un objet refusé.
    function transitionDon(apres, avant) {
      return apres.diff(avant).affectedKeys().hasOnly(['statut', 'resoluLe'])
        && apres.resoluLe is int
        && ((request.auth.uid == avant.aUid && avant.statut == 'propose' && apres.statut in ['accepte', 'refuse'])
          || (request.auth.uid == avant.deUid && avant.statut == 'propose' && apres.statut == 'annule')
          || (request.auth.uid == avant.deUid && avant.statut == 'refuse' && apres.statut == 'repris'));
    }
    // Aligné sur schemaButin et schemaVoteButin (src/lib/schemas/butin.ts), lot L3.4.
    function voteButinValide(v) {
      return v.keys().hasOnly(['choix', 'perso', 'nom', 'd100', 'relances', 'le'])
        && v.keys().hasAll(['choix', 'perso', 'nom', 'd100', 'relances', 'le'])
        && v.choix in ['besoin', 'envie', 'passe']
        && v.perso is string && v.perso.size() >= 1 && v.perso.size() <= 100
        && v.nom is string && v.nom.size() >= 1 && v.nom.size() <= 80
        && v.d100 is int && v.d100 >= 1 && v.d100 <= 100
        && v.relances is list && v.relances.size() <= 20
        && v.le is int;
    }
    function butinValide(d) {
      return d.keys().hasOnly(['objet', 'statut', 'creeLe', 'tour', 'enLice', 'votes', 'gagnant', 'resoluLe'])
        && d.keys().hasAll(['objet', 'statut', 'creeLe', 'tour', 'enLice', 'votes', 'gagnant', 'resoluLe'])
        && d.objet is map
        && d.statut in ['vote', 'relance', 'clos', 'attribue']
        && d.creeLe is int
        && d.tour is int && d.tour >= 0 && d.tour <= 20
        && d.enLice is list && d.enLice.size() <= 50
        && d.votes is map
        && (d.gagnant == null || d.gagnant is map)
        && (d.resoluLe == null || d.resoluLe is int);
    }
    // Un joueur n'écrit que son vote (votes.<uid>). Vote ouvert : choix
    // libre, avec un de ses personnages ; le d100 et le personnage d'un
    // premier vote ne changent plus. Relance : seulement un joueur à
    // égalité, qui ajoute un d100 (1 à 100) pour le tour demandé, rien
    // d'autre.
    function voteJoueurValide(table, apres, avant) {
      return apres.diff(avant).affectedKeys().hasOnly(['votes'])
        && apres.votes.diff(avant.votes).affectedKeys().hasOnly([request.auth.uid])
        && request.auth.uid in apres.votes
        && voteButinValide(apres.votes[request.auth.uid])
        && ((avant.statut == 'vote'
            && apres.votes[request.auth.uid].relances.size() == 0
            && proprietaireDuPerso(table, apres.votes[request.auth.uid].perso)
            && (!(request.auth.uid in avant.votes)
              || (apres.votes[request.auth.uid].d100 == avant.votes[request.auth.uid].d100
                && apres.votes[request.auth.uid].perso == avant.votes[request.auth.uid].perso)))
          || (avant.statut == 'relance'
            && request.auth.uid in avant.enLice
            && request.auth.uid in avant.votes
            && apres.votes[request.auth.uid].choix == avant.votes[request.auth.uid].choix
            && apres.votes[request.auth.uid].d100 == avant.votes[request.auth.uid].d100
            && apres.votes[request.auth.uid].perso == avant.votes[request.auth.uid].perso
            && avant.votes[request.auth.uid].relances.size() == avant.tour - 1
            && apres.votes[request.auth.uid].relances.size() == avant.tour
            // Au premier tour la tranche serait vide, et le moteur de règles
            // refuse `liste[0:0]` (indice -1). La ligne du dessus garantit
            // déjà qu'il n'y avait aucune relance à conserver.
            && (avant.tour == 1 || apres.votes[request.auth.uid].relances[0:avant.tour - 1] == avant.votes[request.auth.uid].relances)
            && apres.votes[request.auth.uid].relances[avant.tour - 1] is int
            && apres.votes[request.auth.uid].relances[avant.tour - 1] >= 1
            && apres.votes[request.auth.uid].relances[avant.tour - 1] <= 100));
    }
    // Aligné sur schemaRencontre (src/lib/schemas/rencontre.ts), lot L3.5.
    // Les règles vérifient le premier niveau ; monstres et butin sont
    // validés par l'app (Zod).
    function rencontreValide(d) {
      return d.keys().hasOnly(['nom', 'scene', 'monstres', 'butin', 'statut', 'creeLe', 'majLe', 'lanceeLe', 'butinEnvoyeLe'])
        && d.keys().hasAll(['nom', 'scene', 'monstres', 'butin', 'statut', 'creeLe', 'majLe', 'lanceeLe', 'butinEnvoyeLe'])
        && d.nom is string && d.nom.size() >= 1 && d.nom.size() <= 80
        && (d.scene == null || (d.scene is string && d.scene.size() >= 1 && d.scene.size() <= 100))
        && d.monstres is list && d.monstres.size() <= 60
        && d.butin is list && d.butin.size() <= 30
        && d.statut in ['preparee', 'lancee']
        && d.creeLe is int && d.majLe is int
        && (d.lanceeLe == null || d.lanceeLe is int)
        && (d.butinEnvoyeLe == null || d.butinEnvoyeLe is int);
    }
    // Aligné sur schemaSeance (src/lib/schemas/seance.ts), lot L3.1.
    function seanceValide(d) {
      return d.keys().hasOnly(['numero', 'ouverteLe', 'closeLe', 'presents'])
        && d.keys().hasAll(['numero', 'ouverteLe', 'closeLe', 'presents'])
        && d.numero is int && d.numero >= 1 && d.numero <= 9999
        && d.ouverteLe is int
        && (d.closeLe == null || d.closeLe is int)
        && d.presents is list && d.presents.size() <= 50;
    }
    // Aligné sur schemaMonstreEnBase (src/lib/schemas/bestiaire.ts), lot
    // L3.2. Les règles vérifient les champs de premier niveau ; le contenu
    // (attaques, capacités, champs des démons) est validé par l'app (Zod).
    function monstreValide(d) {
      return d.keys().hasAll(['nom', 'race', 'pv', 'def', 'init', 'atk', 'dangerosite', 'boss', 'role', 'taille', 'attaques', 'capacitesSpeciales', 'lore', 'emoji', 'origine', 'majLe'])
        && !('id' in d)
        && d.nom is string && d.nom.size() >= 1 && d.nom.size() <= 80
        && d.race is list && d.race.size() >= 1
        && d.pv is int && d.pv >= 1
        && d.def is int && d.init is int && d.atk is int
        && d.dangerosite is int && d.dangerosite >= 1 && d.dangerosite <= 5
        && d.boss is bool
        && d.attaques is list && d.capacitesSpeciales is list
        && d.origine in ['v1', 'mj']
        && d.majLe is int;
    }
    // Aligné sur schemaJetJournal (src/lib/schemas/journal.ts).
    function jetValide(d) {
      return d.keys().hasOnly(['auteurUid', 'auteurNom', 'perso', 'libelle', 'formule', 'des', 'bonus', 'total', 'creeLe'])
        && d.keys().hasAll(['auteurUid', 'auteurNom', 'libelle', 'formule', 'des', 'bonus', 'total', 'creeLe'])
        && d.auteurUid == request.auth.uid
        && nomValide(d.auteurNom)
        && (!('perso' in d) || nomValide(d.perso))
        && d.libelle is string && d.libelle.size() >= 1 && d.libelle.size() <= 80
        && d.formule is string && d.formule.size() >= 1 && d.formule.size() <= 40
        && d.des is list && d.des.size() >= 1 && d.des.size() <= 100
        && d.bonus is int && d.total is int && d.creeLe is int;
    }
    // Personnage joué d'un joueur (joueurs/{uid}.persoActif), '' s'il n'en a pas.
    function persoJoueDe(table, uid) {
      return get(/databases/$(database)/documents/tables/$(table)/joueurs/$(uid)).data.get('persoActif', '');
    }
    function proprietaireDuPerso(table, perso) {
      return estJoueur(table)
        && get(/databases/$(database)/documents/tables/$(table)/persos/$(perso)).data.proprietaireUid == request.auth.uid;
    }
    // Aligné sur schemaPortrait (src/lib/schemas/portrait.ts).
    function portraitValide(d) {
      return d.keys().hasOnly(['image', 'majLe'])
        && d.keys().hasAll(['image', 'majLe'])
        && d.image is string && d.image.size() <= 150000
        && d.image.matches('^data:image/(jpeg|webp|png);base64,.*')
        && d.majLe is int;
    }
    // Un joueur crée son personnage sans crans ni Vécu (seul le MJ en donne).
    function progressionVierge(d) {
      return d.progression.crans == 0 && d.vecu.crans == 0 && d.vecu.paliers == 0 && d.vecu.points == 0;
    }
    // Crans à réunir pour passer du niveau n au suivant. Aligné sur
    // cransRequis (src/lib/regles/progression.ts) : 3 pour les niveaux 2 à
    // 4, 4 pour 5 à 7, 5 pour 8 à 10, 6 pour 11 et 12.
    function cransRequis(n) {
      return n + 1 <= 4 ? 3 : (n + 1 <= 7 ? 4 : (n + 1 <= 10 ? 5 : 6));
    }
    // Montée de niveau par son joueur (L2.5b) : un seul niveau, jusqu'au 12,
    // et les crans requis dépensés d'un coup. Hors montée, le joueur ne
    // touche ni à son niveau ni à ses crans.
    function monteeValide(apres, avant) {
      return apres.niveau == avant.niveau + 1
        && apres.niveau <= 12
        && apres.progression.keys().hasOnly(['crans'])
        && apres.progression.crans == avant.progression.crans - cransRequis(avant.niveau)
        && apres.progression.crans >= 0;
    }
    // Vécu modifié par son joueur : il choisit ses nœuds et dépense ses
    // points, sans toucher aux crans ni aux paliers, que donne le MJ.
    // Lot L4.18 (décision 8a) : chaque nœud ajouté coûte un point, et aucun
    // n'est retiré (seul le MJ en retire) ; le nœud offert se pose une fois.
    // Les tiers et prérequis sont vérifiés par l'app (lib/fiche/vecu.ts).
    function vecuChoisiParJoueur(apres, avant) {
      return apres.crans == avant.crans && apres.paliers == avant.paliers && apres.points <= avant.points
        && apres.noeuds.size() - avant.noeuds.size() == avant.points - apres.points
        && apres.noeuds.hasAll(avant.noeuds)
        && (apres.noeudOffert == avant.noeudOffert || avant.noeudOffert == null);
    }
    // ---- Lore partagé (L2.7a) ----
    // Aligné sur schemaFicheLoreMj / schemaFicheLoreJoueurs
    // (src/lib/schemas/lore.ts). Les règles ne savent pas parcourir une
    // liste : elles vérifient les clés, les types et les tailles ; le
    // contenu des passages est validé par l'app (Zod) avant d'écrire.
    function ficheLoreCommune(d) {
      return d.titre is string && d.titre.size() >= 1 && d.titre.size() <= 120
        && (!('sousTitre' in d) || (d.sousTitre is string && d.sousTitre.size() <= 200))
        && d.categorie is string && d.categorie.size() >= 1 && d.categorie.size() <= 60
        && d.ordre is int
        && d.etiquettes is list && d.etiquettes.size() <= 10
        && d.passages is list && d.passages.size() <= 120
        && d.majLe is int && d.reveleLe is int;
    }
    function ficheLoreMjValide(d) {
      return d.keys().hasAll(['titre', 'categorie', 'ordre', 'etiquettes', 'visibilite', 'lecteurs', 'passages', 'majLe', 'reveleLe'])
        && d.keys().hasOnly(['titre', 'sousTitre', 'categorie', 'ordre', 'etiquettes', 'visibilite', 'lecteurs', 'passages', 'majLe', 'reveleLe', 'source'])
        && ficheLoreCommune(d)
        && d.visibilite in ['mj', 'certains', 'tous']
        && d.lecteurs is list && d.lecteurs.size() <= 50
        && (!('source' in d) || (d.source is string && d.source.size() <= 120));
    }
    function ficheLoreJoueursValide(d) {
      return d.keys().hasAll(['titre', 'categorie', 'ordre', 'etiquettes', 'lecteurs', 'passages', 'majLe', 'reveleLe'])
        && d.keys().hasOnly(['titre', 'sousTitre', 'categorie', 'ordre', 'etiquettes', 'lecteurs', 'passages', 'majLe', 'reveleLe'])
        && ficheLoreCommune(d)
        && d.lecteurs is list && d.lecteurs.size() >= 1 && d.lecteurs.size() <= 50;
    }
    // Aligné sur schemaEtatScene (src/lib/schemas/carte.ts).
    function etatSceneValide(d) {
      return d.keys().hasOnly(['portesOuvertes', 'exploration', 'explorationRaz'])
        && (!('portesOuvertes' in d) || d.portesOuvertes is map)
        && (!('exploration' in d) || (d.exploration is string && d.exploration.size() <= 20000))
        && (!('explorationRaz' in d) || d.explorationRaz is int);
    }

    match /tables/{table} {
      allow read: if estMembre(table);
      allow write: if estMj(table);

      // Code MJ : posé à la main dans la console Firebase, jamais lisible
      // ni modifiable par un client. Seules les règles le consultent.
      match /secret/{document} {
        allow read, write: if false;
      }

      // Devenir MJ : uniquement pour soi, avec le bon code.
      match /mjs/{uid} {
        allow read: if connecte() && (request.auth.uid == uid || estMj(table));
        allow create: if connecte()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['nom', 'code', 'rejointLe'])
          && nomValide(request.resource.data.nom)
          && request.resource.data.rejointLe is int
          && request.resource.data.code
             == get(/databases/$(database)/documents/tables/$(table)/secret/codeMj).data.code;
        allow update, delete: if false;
      }

      // Devenir joueur : uniquement pour soi. Le MJ peut retirer un joueur
      // (un doublon, par exemple). `protege` (correctif du 19/10) : le joueur
      // a un code perso et se retrouve sur un autre appareil ; c'est son
      // compte pseudo + code qui le garantit, ce champ ne sert qu'à l'affichage.
      match /joueurs/{uid} {
        allow read: if connecte() && (request.auth.uid == uid || estMembre(table));
        allow create, update: if connecte()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['nom', 'couleur', 'persoActif', 'protege', 'rejointLe'])
          && nomValide(request.resource.data.nom)
          && (!('protege' in request.resource.data) || request.resource.data.protege is bool)
          && request.resource.data.rejointLe is int;
        allow delete: if estMj(table);
      }

      // ---- Battlemap (lot L5.3) ----
      // Les règles vérifient les DROITS ; les règles de jeu (murs, portes
      // fermées, case occupée) sont appliquées par l'app avant d'écrire,
      // comme en v1 : Firestore ne connaît pas la géométrie des scènes.
      // `sceneActive` (scène montrée) est un champ du document de table,
      // écrit par le MJ (règle de /tables/{table} ci-dessus).
      match /scenes/{scene} {
        allow read: if estMembre(table);
        // MJ : portes, exploration et sa remise à zéro.
        allow create, update: if estMj(table) && etatSceneValide(request.resource.data);
        // Joueur : seulement les portes (n'importe laquelle, décision 3b).
        allow create: if estJoueur(table)
          && request.resource.data.keys().hasOnly(['portesOuvertes'])
          && request.resource.data.portesOuvertes is map;
        allow update: if estJoueur(table)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['portesOuvertes'])
          && request.resource.data.portesOuvertes is map;
        allow delete: if estMj(table);

        // Dessins du MJ (lot L5.4) : murs, obstacles, portes, mur de force.
        // Le MJ seul les trace et les efface ; une porte dessinée s'ouvre
        // comme les autres, par portesOuvertes (ci-dessus).
        match /dessins/{dessin} {
          allow read: if estMembre(table);
          allow create, update: if estMj(table) && dessinValide(request.resource.data);
          allow delete: if estMj(table);
        }

        // Un document par jeton. Le MJ pose, bouge, tue et retire tout. Un
        // joueur pose le jeton de son personnage JOUÉ (identifiant
        // pj-<id du personnage>, L2.3 ; L5.3 : pj-<uid>), ne bouge que ses
        // jetons (cx et cy seulement) et peut les retirer.
        match /jetons/{jeton} {
          allow read: if estMembre(table);
          allow create: if jetonValide(request.resource.data)
            && (estMj(table)
              || (estJoueur(table)
                && persoJoueDe(table, request.auth.uid) != ''
                && jeton == 'pj-' + persoJoueDe(table, request.auth.uid)
                && get(/databases/$(database)/documents/tables/$(table)/persos/$(persoJoueDe(table, request.auth.uid))).data.proprietaireUid == request.auth.uid
                && request.resource.data.genre == 'pj'
                && request.resource.data.proprietaire == request.auth.uid
                && !('mort' in request.resource.data)));
          allow update: if jetonValide(request.resource.data)
            && (estMj(table)
              || (estJoueur(table)
                && resource.data.proprietaire == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cx', 'cy'])));
          allow delete: if estMj(table)
            || (estJoueur(table) && resource.data.proprietaire == request.auth.uid);
        }
      }

      // Scènes importées par le MJ depuis une image (lot L5.5) : la
      // description d'un côté (légère, listée par tous), l'image de l'autre
      // (téléchargée seulement à l'ouverture de la scène).
      match /scenesImportees/{scene} {
        allow read: if estMembre(table);
        allow create, update: if estMj(table)
          && request.resource.data.keys().hasOnly(['nom', 'colonnes', 'lignes', 'pxParCase', 'creeLe'])
          && request.resource.data.keys().hasAll(['nom', 'colonnes', 'lignes', 'pxParCase', 'creeLe'])
          && nomValide(request.resource.data.nom)
          && request.resource.data.colonnes is int && request.resource.data.colonnes >= 1 && request.resource.data.colonnes <= 150
          && request.resource.data.lignes is int && request.resource.data.lignes >= 1 && request.resource.data.lignes <= 150
          && request.resource.data.pxParCase is int && request.resource.data.pxParCase >= 1 && request.resource.data.pxParCase <= 512
          && request.resource.data.creeLe is int;
        allow delete: if estMj(table);

        match /image/{document} {
          allow read: if estMembre(table);
          allow create, update: if estMj(table)
            && request.resource.data.keys().hasOnly(['image'])
            && request.resource.data.image is string
            && request.resource.data.image.matches('^data:image/.*')
            && request.resource.data.image.size() <= 750000;
          allow delete: if estMj(table);
        }
      }

      // Fiches de personnage (lot L2.1). Toute la table les lit (la fiche
      // vivante du MJ, les cartes compactes du groupe). Un joueur crée et
      // modifie SES personnages (il peut en avoir plusieurs, décision 2a),
      // sans pouvoir les donner à un autre ni se donner des crans de
      // progression ou de Vécu (le MJ les donne ; le joueur choisit ses
      // nœuds). Le MJ fait tout ; lui seul supprime. Les documents de crans
      // (persos/{id}/jalons, L2.5) : le MJ seul les crée, personne ne les
      // modifie ni ne les supprime.
      // Fiches v1 déposées par le MJ pour un joueur (lot L2.2c, décision 6a).
      // Le joueur ne lit que les siennes et ne fait qu'une chose : noter,
      // une seule fois, le personnage qui en est né (reprisPar).
      match /importsV1/{imp} {
        allow read: if estMj(table)
          || (estJoueur(table) && resource.data.proprietaireUid == request.auth.uid);
        allow create: if estMj(table) && importValide(request.resource.data);
        allow delete: if estMj(table);
        allow update: if importValide(request.resource.data)
          && (estMj(table)
            || (estJoueur(table)
              && resource.data.proprietaireUid == request.auth.uid
              && !('reprisPar' in resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reprisPar'])));
      }

      match /persos/{perso} {
        allow read: if estMembre(table);
        allow create: if ficheValide(request.resource.data)
          && (estMj(table)
            || (estJoueur(table)
              && request.resource.data.proprietaireUid == request.auth.uid
              && progressionVierge(request.resource.data)
              && (request.resource.data.schemaVersion == 1 || octroisVierges(request.resource.data.octrois))));
        allow update: if ficheValide(request.resource.data)
          && (estMj(table)
            || (estJoueur(table)
              && resource.data.proprietaireUid == request.auth.uid
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['proprietaireUid', 'creeLe'])
              && ((resource.data.schemaVersion == 1 && request.resource.data.schemaVersion == 1)
                || refonteParJoueur(request.resource.data, resource.data))
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['niveau', 'progression'])
                || monteeValide(request.resource.data, resource.data))
              && vecuChoisiParJoueur(request.resource.data.vecu, resource.data.vecu)));
        allow delete: if estMj(table);

        // Portrait (L2.3, décision 6a) : un document à part, lu par toute la
        // table (avatar, jeton) ; le propriétaire du personnage et le MJ le
        // changent ou le retirent.
        match /images/{image} {
          allow read: if estMembre(table);
          allow create, update: if image == 'portrait'
            && portraitValide(request.resource.data)
            && (estMj(table) || proprietaireDuPerso(table, perso));
          allow delete: if estMj(table) || proprietaireDuPerso(table, perso);
        }

        // Crans de progression (L2.5) : un document par cran, en ajout seul,
        // écrit par le MJ dans la même transaction que progression.crans.
        match /jalons/{jalon} {
          allow read: if estMembre(table);
          allow create: if estMj(table) && jalonValide(request.resource.data);
          allow update, delete: if false;
        }
      }

      // Journal de dés commun (L2.5, décision 4a) : toute la table lit tous
      // les jets ; chacun n'ajoute que les siens ; personne ne modifie ni ne
      // supprime un jet.
      match /journal/{jet} {
        allow read: if estMembre(table);
        allow create: if estMembre(table) && jetValide(request.resource.data);
        allow update, delete: if false;
      }

      // Séances (L3.1, décisions du 18/10/2026) : toute la table les lit ;
      // le MJ seul les ouvre, coche les présents et les clôt. La séance
      // ouverte est aussi notée dans le document de la table
      // (seanceOuverte), écrit par le MJ (règle de /tables/{table}).
      match /seances/{seance} {
        allow read: if estMembre(table);
        allow create, update: if estMj(table) && seanceValide(request.resource.data);
        allow delete: if estMj(table);
      }

      // Dons d'objets entre joueurs (L3.3, décision du 18/10/2026 : proposé
      // puis accepté). Lus du MJ, du donneur et du receveur seulement
      // (requêtes joueur : deUid == uid, puis aUid == uid). Le donneur crée
      // la proposition depuis l'un de ses personnages vers le personnage d'un
      // autre joueur ; seul le statut change ensuite (transitionDon). L'objet
      // voyage dans le don : il quitte un sac et entre dans l'autre dans la
      // même transaction que le changement de statut (lib/actions/dons.ts).
      // Que l'objet sorte bien du sac du donneur reste une règle de l'app :
      // sans Cloud Functions (plan Spark), les règles ne savent pas comparer
      // deux documents objet par objet.
      match /dons/{don} {
        allow read: if estMj(table)
          || (estJoueur(table) && (resource.data.deUid == request.auth.uid || resource.data.aUid == request.auth.uid));
        allow create: if estJoueur(table)
          && donValide(request.resource.data)
          && request.resource.data.deUid == request.auth.uid
          && request.resource.data.aUid != request.auth.uid
          && request.resource.data.statut == 'propose'
          && request.resource.data.resoluLe == null
          && proprietaireDuPerso(table, request.resource.data.dePerso)
          && get(/databases/$(database)/documents/tables/$(table)/persos/$(request.resource.data.aPerso)).data.proprietaireUid == request.resource.data.aUid;
        allow update: if estJoueur(table)
          && donValide(request.resource.data)
          && transitionDon(request.resource.data, resource.data);
        allow delete: if estMj(table);
      }

      // Butin (L3.4, décisions des 18 et 19/10/2026) : toute la table lit
      // les butins et les votes. Le MJ crée, clôt, attribue (directement ou
      // au gagnant : l'objet entre dans le sac dans la même transaction) et
      // retire. Un joueur n'écrit que son vote (voteJoueurValide).
      match /butins/{butin} {
        allow read: if estMembre(table);
        allow create, update: if estMj(table) && butinValide(request.resource.data);
        allow update: if estJoueur(table)
          && butinValide(request.resource.data)
          && voteJoueurValide(table, request.resource.data, resource.data);
        allow delete: if estMj(table);
      }

      // Rencontres préparées (L3.5, décisions du 19/10/2026) : lisibles du
      // MJ seul, comme le bestiaire qu'elles nomment. Lancer une rencontre
      // pose des jetons de monstre ordinaires (règles des jetons).
      match /rencontres/{rencontre} {
        allow read, delete: if estMj(table);
        allow create, update: if estMj(table) && rencontreValide(request.resource.data);
      }

      // Bestiaire du MJ (L3.2, décision du 18/10/2026) : lisible du MJ seul,
      // comme le lore complet. Jamais livré avec l'app (correctif du
      // 18/10) : les joueurs ne peuvent ni le lire ni l'écrire.
      match /bestiaire/{monstre} {
        allow read, delete: if estMj(table);
        allow create, update: if estMj(table) && monstreValide(request.resource.data);
      }
      match /bestiaireDonnees/{donnees} {
        allow read: if estMj(table);
        allow write: if estMj(table) && donnees in ['armes', 'armures', 'equilibrage'];
      }

      // Lore partagé (L2.7a, décisions du 18/10/2026). La fiche complète,
      // passages scellés compris, n'est lisible que du MJ (loreMj). Les
      // joueurs lisent la version dérivée (lore), seulement si leur uid ou
      // « * » (tous) est dans `lecteurs` ; un texte scellé n'y est jamais
      // écrit. Requêtes joueur : lecteurs array-contains uid, puis
      // lecteurs array-contains '*' (chacune est prouvée par la règle).
      match /loreMj/{fiche} {
        allow read, delete: if estMj(table);
        allow create, update: if estMj(table) && ficheLoreMjValide(request.resource.data);
      }
      match /lore/{fiche} {
        allow read: if estMj(table)
          || (estJoueur(table)
            && (request.auth.uid in resource.data.lecteurs || '*' in resource.data.lecteurs));
        allow create, update: if estMj(table) && ficheLoreJoueursValide(request.resource.data);
        allow delete: if estMj(table);
      }

      // Toute autre collection (combat…) est refusée par défaut :
      // chaque lot ouvre la sienne avec ses propres tests.
    }
  }
}
