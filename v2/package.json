{
  "name": "cof-compagno-v2",
  "private": true,
  "version": "2.0.0-alpha.0",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings && tsc -p tsconfig.tests.json && tsc -p tsconfig.node.json",
    "cycles": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "verifier": "npm run check && npm run cycles && npm run test && npm run build"
  },
  "dependencies": {
    "firebase": "13.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.6.0",
    "firebase-tools": "15.34.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
