{
  "name": "cof-compagno-v2",
  "private": true,
  "version": "2.0.0-alpha.0",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:emulateurs": "firebase emulators:exec --only auth,firestore --ui \"vite --mode emulateurs\"",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings && tsc -p tsconfig.tests.json && tsc -p tsconfig.node.json",
    "cycles": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:regles": "firebase emulators:exec --only firestore --project demo-cof-compagno \"vitest run --config vitest.regles.config.ts\"",
    "importer-v1": "node outils/importer-v1.ts",
    "donnees:verifier": "node outils/importer-v1.ts --verifier",
    "preparer-scenes": "node outils/preparer-scenes.ts",
    "scenes:verifier": "node outils/preparer-scenes.ts --verifier",
    "lore:exporter": "node outils/exporter-lore-v1.ts",
    "secrets:verifier": "node outils/verifier-secrets.ts",
    "bestiaire:exporter": "node outils/exporter-bestiaire.ts",
    "verifier": "npm run donnees:verifier && npm run scenes:verifier && npm run check && npm run cycles && npm run test && npm run build && npm run secrets:verifier && npm run test:regles",
    "deployer": "npm run verifier && firebase deploy --only hosting:v2,firestore:rules"
  },
  "dependencies": {
    "firebase": "13.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.6.0",
    "firebase-tools": "15.34.0",
    "jsdom": "30.1.1",
    "sharp": "0.35.5",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
